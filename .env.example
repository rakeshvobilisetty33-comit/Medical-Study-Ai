# MedStudy AI Environment Configuration

# Server running configurations
PORT=5000

# MongoDB local or cloud URI
MONGO_URI=mongodb://localhost:27017/medstudy

# Active AI provider: 'gemini' | 'openai' | 'mock'
AI_PROVIDER=mock

# AI model selection (defaults: 'gemini-1.5-flash' or 'gpt-4o-mini')
AI_MODEL=

# API keys for LLM integration (Uncomment and populate to use external providers)
# GEMINI_API_KEY=your-gemini-key
# OPENAI_API_KEY=your-openai-key
